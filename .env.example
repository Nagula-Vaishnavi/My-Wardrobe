# Copy these entries into your IDE run configuration or a local .env file.
# Do not commit real passwords or JWT secrets.
DB_URL=jdbc:mysql://127.0.0.1:3306/mywardrobe
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
